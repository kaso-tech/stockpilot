# Modèle de configuration StockPilot Pro — copier en .env et compléter.
# Aucune valeur réelle ne doit être versionnée.

# --- Obligatoire ---
DATABASE_URL=mysql://user:password@host:3306/stockpilot
# Secret de signature des sessions : 32 caractères minimum en production.
JWT_SECRET=

# --- Réseau ---
PORT=3000
# Nombre de proxys de confiance devant l'application (calcul de l'IP client et du protocole).
TRUST_PROXY=1
# Origines autorisées à afficher l'application dans un iframe (CSP frame-ancestors).
FRAME_ANCESTORS='self'
# URL publique fixe (utilisée pour le retour OAuth Google Drive).
PUBLIC_APP_URL=

# --- Chiffrement (32 octets : 64 caractères hexadécimaux ou base64) ---
# Chiffre les archives de sauvegarde au repos et sur Google Drive. À conserver précieusement :
# sans elle, les archives chiffrées ne sont plus restaurables.
BACKUP_ENCRYPTION_KEY=
# Chiffre les jetons Google Drive (à défaut : ancienne dérivation depuis JWT_SECRET).
DRIVE_TOKEN_ENCRYPTION_KEY=

# --- Google Drive (facultatif) ---
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# --- Plateforme Manus (stockage, tâches planifiées) ---
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# --- Développement uniquement ---
# Initialise le mot de passe de l'administrateur existant au démarrage (ignoré en production).
ADMIN_FALLBACK_EMAIL=
ADMIN_FALLBACK_PASSWORD=
# Tests d'intégration MySQL : pnpm test:db
TEST_DATABASE_URL=
